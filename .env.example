# Copy to `.env.local` and adjust. Never commit `.env.local`.
# cp .env.example .env.local

# Base URL of the Botcraft API, including the version prefix and no trailing
# slash. Every request path in src/lib/api/endpoints is relative to this.
# The playground WebSocket URL is derived from it, so an https:// value
# automatically yields wss://.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
